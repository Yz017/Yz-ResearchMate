# DeepSeek / LiteLLM
DEEPSEEK_API_KEY=
RESEARCHMATE_LLM_MODEL=deepseek/deepseek-chat

# Aliyun OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# Local service
RESEARCH_AGENT_TOKEN=change-me-to-a-random-token-with-at-least-32-chars
RESEARCH_AGENT_BIND=127.0.0.1:8000
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
EMBEDDING_DEVICE=auto
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_BATCH_SIZE=16
RERANK_BACKEND=auto
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ALLOW_DOWNLOAD=false
CHROMA_DIR=./data/chroma
KB_COLLECTION=kb_chunks
RAG_DENSE_K=20
RAG_SPARSE_K=20
RAG_FINAL_K=5
