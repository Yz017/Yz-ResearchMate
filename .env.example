# DeepSeek / LiteLLM
DEEPSEEK_API_KEY=
RESEARCHMATE_LLM_MODEL=deepseek/deepseek-chat

# Aliyun OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_LOCAL_DIR=./data/oss
OSS_CACHE_DIR=./data/cache

# Local service
RESEARCH_AGENT_TOKEN=change-me-to-a-random-token-with-at-least-32-chars
RESEARCH_AGENT_BIND=127.0.0.1:8000
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
EMBEDDING_DEVICE=auto
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_BATCH_SIZE=16
RERANK_BACKEND=auto
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ALLOW_DOWNLOAD=false
CHROMA_DIR=./data/chroma
KB_COLLECTION=kb_chunks
MEMORY_COLLECTION=memory_records
JOBS_DB_PATH=./data/jobs.db
PAPERS_DB_PATH=./data/papers.db
MEMORY_IDLE_ARCHIVE_SECONDS=1800
MEMORY_IDLE_SCAN_SECONDS=300
MEMORY_MAX_SESSION_FACTS=8
RAG_DENSE_K=20
RAG_SPARSE_K=20
RAG_FINAL_K=5
